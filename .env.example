# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/bridge_initiative

# Auth
JWT_SECRET=change_this_to_a_long_random_string
